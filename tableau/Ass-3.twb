      <column caption='Delivery Efficincy' datatype='string' name='[Calculation_0384603882020864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Time_Min] &gt; 30 THEN &quot;delayed&quot;&#13;&#10;ELSE &quot;fast&quot;&#13;&#10;END' />
